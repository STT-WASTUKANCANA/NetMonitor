datasource db {
  provider = "mysql"
  url      = "mysql://root@localhost:3307/netmonitor"
}

generator client {
  provider = "prisma-client-py"
}

enum UserRole {
  admin
  petugas
}

enum DeviceType {
  router
  switch
  access_point
  server
  firewall
  other
}

enum HierarchyLevel {
  utama
  sub
  device
}

enum DeviceStatus {
  up
  down
  unknown
}

enum AlertSeverity {
  low
  medium
  high
  critical
}

enum AlertStatus {
  active
  acknowledged
  resolved
}

enum LogStatus {
  up
  down
}

model User {
  id                BigInt    @id @default(autoincrement())
  first_name        String    @db.VarChar(255)
  last_name         String    @db.VarChar(255)
  email             String    @unique @db.VarChar(255)
  email_verified_at DateTime?
  password          String    @db.VarChar(255)
  role              UserRole  @default(petugas)
  profile_photo     String?   @db.VarChar(255)
  remember_token    String?   @db.VarChar(100)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @default(now()) @updatedAt

  // Relationships
  devices_created Device[] @relation("UserCreatedDevices")
  alerts_resolved Alert[]  @relation("UserResolvedAlerts")

  @@map("users")
}

model Device {
  id              BigInt         @id @default(autoincrement())
  name            String         @db.VarChar(255)
  ip_address      String         @unique @db.VarChar(45)
  type            DeviceType
  hierarchy_level HierarchyLevel @default(device)
  parent_id       BigInt?
  location        String?        @db.VarChar(255)
  description     String?        @db.Text
  port            Int?
  status          DeviceStatus   @default(unknown)
  last_checked_at DateTime?
  created_by      BigInt?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @default(now()) @updatedAt

  // Relationships
  parent   Device?     @relation("DeviceHierarchy", fields: [parent_id], references: [id], onDelete: Cascade)
  children Device[]    @relation("DeviceHierarchy")
  creator  User?       @relation("UserCreatedDevices", fields: [created_by], references: [id], onDelete: SetNull)
  logs     DeviceLog[]
  alerts   Alert[]

  @@index([hierarchy_level])
  @@index([status])
  @@map("devices")
}

model Alert {
  id          BigInt       @id @default(autoincrement())
  device_id   BigInt
  message     String       @db.Text
  severity    AlertSeverity @default(medium)
  status      AlertStatus   @default(active)
  resolved_at DateTime?
  resolved_by BigInt?
  created_at  DateTime      @default(now())
  updated_at  DateTime      @default(now()) @updatedAt

  // Relationships
  device   Device @relation(fields: [device_id], references: [id], onDelete: Cascade)
  resolver User?  @relation("UserResolvedAlerts", fields: [resolved_by], references: [id], onDelete: SetNull)

  @@index([device_id])
  @@index([severity])
  @@index([status])
  @@map("alerts")
}

model DeviceLog {
  id            BigInt    @id @default(autoincrement())
  device_id     BigInt
  status        LogStatus
  response_time Decimal?  @db.Decimal(8, 2)
  packet_loss   Decimal?  @db.Decimal(5, 2)
  checked_at    DateTime

  // No created_at in python model but usually good to have default db timestamp? 
  // Python model has created_at = Column(DateTime, default=datetime.utcnow)
  created_at DateTime @default(now())

  // Relationships
  device Device @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@index([device_id])
  @@index([checked_at])
  @@map("device_logs")
}
